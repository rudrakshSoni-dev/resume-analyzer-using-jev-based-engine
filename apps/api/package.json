{
  "name": "@jev/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "postinstall": "prisma generate",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/engine/jev/jev.test.ts",
    "test:jev": "tsx --test src/engine/jev/jev.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
