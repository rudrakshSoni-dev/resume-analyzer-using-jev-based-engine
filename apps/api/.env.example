# JEV Resume Analyzer - API Environment Variables
# Copy this to .env and fill in actual values

# ============================================================================
# Database
# ============================================================================
# PostgreSQL connection string from Neon (or other PostgreSQL provider)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host.region.neon.tech/jev_resume_analyzer?sslmode=require"

# ============================================================================
# Authentication
# ============================================================================
# Secret key for signing JWTs - MUST be cryptographically random
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-key-min-32-characters-long"

# JWT expiration time (e.g., "7d", "24h", "30m")
JWT_EXPIRES_IN="7d"

# ============================================================================
# Server Configuration
# ============================================================================
# Port the API server listens on
PORT=3002

# Node environment: development | production | test
NODE_ENV="development"

# CORS origin for the frontend (Next.js app)
CORS_ORIGIN="http://localhost:3000"

# ============================================================================
# File Upload Limits
# ============================================================================
# Maximum file size for resume uploads (in bytes)
# Default: 5MB = 5 * 1024 * 1024
MAX_FILE_SIZE=5242880

# ============================================================================
# Security
# ============================================================================
# Bcrypt/Argon2 cost factor (higher = more secure but slower)
# Recommended: 10-12 for bcrypt
PASSWORD_HASH_ROUNDS=10
